# ============================================
# PDF Summarizer - Production Environment Variables
# 方案A: 免费版部署 (月成本 ¥0)
# ============================================
# 在 Vercel Dashboard → Settings → Environment Variables 中配置
# Scope 选 Production（和 Preview）
# https://vercel.com/docs/projects/environment-variables
# ============================================

# ============ [必填] 数据库 (Supabase 免费版 500MB) ============
# Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ============ [必填] 认证密钥 (JWT 签名) ============
# 本地生成: openssl rand -hex 32  (至少 16 字符)
AUTH_SECRET=replace_with_64char_random_hex_string

# ============ [必填] AI 提供商 (至少一个) ============
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxx
# 可选备用提供商 (失败时自动降级):
# GROQ_API_KEY=gsk_xxx
# SILICONFLOW_API_KEY=sk-xxx

# ============ [可选] 缓存 (免费版不配，自动降级为内存 LRU) ============
# 不配置时，AI 摘要缓存和速率限制自动降级为单实例内存模式，功能完全正常
# 流量增大后再考虑启用 Upstash Redis 免费版 (10000 req/天)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# ============ [可选] 邮件 (Resend 免费版 3000 封/月) ============
# 不配置时密码重置降级，不影响核心摘要功能
RESEND_API_KEY=re_xxx
EMAIL_FROM="PDFSum <noreply@pdfsum.com>"

# ============ [可选] 支付 (免费版不配 → 付费方案自动隐藏为 Coming Soon) ============
# 下一阶段启用付费版时配置。配置 CREEM_SECRET_KEY 后 Pro/Pro+ 自动恢复
# NEXT_PUBLIC_ENABLE_PAYMENT=true
# NEXT_PUBLIC_CREEM_PRICE_MONTHLY=prod_xxx
# NEXT_PUBLIC_CREEM_PRICE_YEARLY=prod_xxx
# CREEM_SECRET_KEY=creem_xxx
# CREEM_WEBHOOK_SECRET=whsec_xxx

# ============ [必填] 应用配置 ============
# 部署后用 Vercel 分配的域名替换，或自定义域名
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
ADMIN_EMAIL=your-email@example.com
CRON_SECRET=replace_with_random_secret
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ============ [可选] 监控 ============
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_CLARITY_ID=xxx

# ============ [可选] 支持 ============
NEXT_PUBLIC_SUPPORT_EMAIL=support@pdfsum.com
