# ============================================
# PDF Summarizer - Local Development Config
# ============================================
# Copy to .env.local and fill in your values

# ============ DATABASE ============
DATABASE_URL="file:./dev.db"

# ============ AUTH ============
AUTH_SECRET=replace_with_64char_hex_secret

# ============ AI PROVIDER (at least one) ============
DEEPSEEK_API_KEY=sk-xxx
# GROQ_API_KEY=gsk_xxx
# SILICONFLOW_API_KEY=sk-xxx

# ============ CREEM PAYMENTS ============
NEXT_PUBLIC_CREEM_PRICE_MONTHLY=prod_xxx
NEXT_PUBLIC_CREEM_PRICE_YEARLY=prod_xxx
CREEM_SECRET_KEY=creem_xxx
CREEM_WEBHOOK_SECRET=whsec_xxx

# ============ EMAIL (Resend) ============
RESEND_API_KEY=re_xxx
EMAIL_FROM="PDFSum <noreply@pdfsum.com>"

# ============ APP ============
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
CRON_SECRET=replace_with_random_secret

# ============ OPTIONAL ============
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_CLARITY_ID=xxx
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
