# ============================================
# PDF Summarizer - Quick Setup Guide
# ============================================

# 第一步：配置 AI Provider
# ─────────────────────────
# DeepSeek (推荐): https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxx

# 备选（可选）:
# Groq: https://console.groq.com
# GROQ_API_KEY=gsk-xxx
# SiliconFlow: https://www.siliconflow.com
# SILICONFLOW_API_KEY=sk-xxx

# 第二步：配置数据库
# ─────────────────────────
DATABASE_URL="file:./dev.db"

# 第三步：配置认证 (自建 JWT)
# ─────────────────────────
AUTH_SECRET=openssl_rand_hex_64_char_secret

# 第四步：配置 Creem 支付 (可选 - 本地开发可跳过)
# ─────────────────────────
# 注册: https://creem.io
NEXT_PUBLIC_CREEM_PRICE_MONTHLY=prod_xxx
NEXT_PUBLIC_CREEM_PRICE_YEARLY=prod_xxx
CREEM_SECRET_KEY=creem_xxx
CREEM_WEBHOOK_SECRET=whsec_xxx

# 第五步：配置邮件 (可选)
# ─────────────────────────
# Resend: https://resend.com
RESEND_API_KEY=re_xxx
EMAIL_FROM="PDFSum <noreply@pdfsum.com>"

# 第六步：应用配置
# ─────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
CRON_SECRET=random_secret_for_cron_jobs

# 可选增强:
# ─────────────────────────
# Sentry 错误监控: https://sentry.io
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# Microsoft Clarity 用户行为录制: https://clarity.microsoft.com
# NEXT_PUBLIC_CLARITY_ID=xxx
# Upstash Redis (生产推荐): https://console.upstash.io
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
